# ==============================================================================
# Beautify Africa - Backend Environment Configuration Template
# Copy this file to Back-End/.env and fill in the values for your environment.
# DO NOT commit the actual .env file with production secrets.
# ==============================================================================

# Server Environment Profile: 'development' | 'staging' | 'production' | 'test'
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Comma-separated list of permitted CORS frontend domains
# In production: https://beautify-africa.com,https://www.beautifyafrica.app
# In staging: https://beautify-africa-staging.vercel.app
CLIENT_URL=http://localhost:5173,http://localhost:4173

# Infrastructure Security Flags
# Set to 'true' in staging/production or behind reverse proxies to force HTTPS redirection and HSTS headers
FORCE_HTTPS=false
FORCE_HSTS=false

# PostgreSQL Database (Sequelize + Umzug)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/beautify_africa
PG_MAX_POOL_SIZE=20
PG_MIN_POOL_SIZE=2
PG_SSL_REJECT_UNAUTHORIZED=false

# Redis Cache & BullMQ Queue Worker
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Secret Management & Cryptographic Keys
# Rule: Secrets must be at least 32 characters long.
# Generate secure random keys with:
#   $ openssl rand -base64 32
# Never use placeholder strings (e.g., 'replace_with_...') in production.
# ==============================================================================
JWT_SECRET=replace_with_a_super_secure_jwt_secret_minimum_32_chars
REFRESH_TOKEN_SECRET=replace_with_a_super_secure_refresh_secret_minimum_32_chars
# A distinct 32-byte key (base64 or 64-character hex) for AES-256-GCM encryption of TOTP secrets.
TOTP_ENCRYPTION_KEY=replace_with_a_32_byte_base64_or_64_char_hex_key

# Admin User Credentials (Optional default bootstrapping)
ADMIN_EMAILS=admin@beautify-africa.com
ADMIN_DASHBOARD_PASSWORD=replace_with_a_strong_admin_password_16_chars

# Stripe Payments & Webhooks
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# Pan-African Regional Payments (M-Pesa Daraja STK Push)
# Get credentials from https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/webhook/mpesa

# Paystack Pan-African Payments (Cards, USSD, Bank Transfers)
# Get test/live keys from https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
# Comma-separated production gateways. Each enabled gateway must have valid credentials.
ENABLED_PAYMENT_GATEWAYS=stripe

# Email Dispatch Service (Resend or SMTP)
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM=no-reply@beautify-africa.com
# Optional SMTP configuration fallback:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.com
# SMTP_PASS=smtp_password

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# Structured Logging & Observability (Pino)
LOG_LEVEL=info

# Database Backup Storage Directory
BACKUP_STORAGE_DIR=./backups
