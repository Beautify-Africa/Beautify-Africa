# ==============================================================================
# Beautify Africa - Backend Environment Configuration Template
# Copy this file to Back-End/.env and fill in the values for your environment.
# DO NOT commit the actual .env file with production secrets.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database (Sequelize + Umzug)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/beautify_africa
PG_MAX_POOL_SIZE=20
PG_MIN_POOL_SIZE=2
PG_SSL_REJECT_UNAUTHORIZED=false

# Redis Cache & BullMQ Queue Worker
REDIS_URL=redis://localhost:6379

# Authentication & Security (Generate secure random keys with `openssl rand -base64 32`)
JWT_SECRET=replace_with_a_super_secure_jwt_secret_minimum_32_chars
REFRESH_TOKEN_SECRET=replace_with_a_super_secure_refresh_secret_minimum_32_chars

# Stripe Payments & Webhooks
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# Email Dispatch Service (Resend or SMTP)
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM=no-reply@beautify-africa.com
# Optional SMTP configuration fallback:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.com
# SMTP_PASS=smtp_password

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# Structured Logging & Observability (Pino)
LOG_LEVEL=info
