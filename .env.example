# ==============================================================================
# Beautify Africa - Monorepo & Docker Compose Environment Template
# Copy this file to .env at project root to configure docker-compose services.
# ==============================================================================

# PostgreSQL Container Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=beautify_africa
DATABASE_URL=postgres://postgres:postgres@postgres:5432/beautify_africa

# Redis Container URL
REDIS_URL=redis://redis:6379

# Frontend & Vite Build Arguments
VITE_API_URL=http://localhost:5000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key

# Backend Secrets
JWT_SECRET=replace_with_a_super_secure_jwt_secret_minimum_32_chars
REFRESH_TOKEN_SECRET=replace_with_a_super_secure_refresh_secret_minimum_32_chars
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret
